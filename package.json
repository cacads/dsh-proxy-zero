{
  "name": "dsh-proxy-zero",
  "version": "0.1.0",
  "description": "DSH 代理插件：让 DeepSeek Harness 走 HTTP(S) 代理，且卸载后不残留任何配置、文件或状态。Zero-residue proxy plugin for DeepSeek Harness.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "proxy",
    "http-proxy",
    "zero-residue"
  ],
  "author": "cacads",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cacads/dsh-proxy-zero.git"
  },
  "homepage": "https://github.com/cacads/dsh-proxy-zero",
  "bugs": {
    "url": "https://github.com/cacads/dsh-proxy-zero/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-http-proxy": ">=0.1.3-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-http-proxy": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
